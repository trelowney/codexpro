#!/bin/bash
# Signing in from inside a container is the part people get stuck on, because
# Codex's normal browser sign-in expects a callback on localhost:1455 *inside*
# this container - a browser on your laptop can never reach that. So this helper
# offers the flows that do work here, easiest first.
[ -f /etc/profile.d/codexpro.sh ] && . /etc/profile.d/codexpro.sh

set -u

CODEX_HOME="${CODEX_HOME:-/data/codex}"
AUTH_FILE="${CODEX_HOME}/auth.json"
SHARED_AUTH="/share/codex-auth.json"
CALLBACK_PORT=1455

C_TITLE=$'\033[1;36m'
C_WARN=$'\033[1;33m'
C_OK=$'\033[1;32m'
C_DIM=$'\033[2m'
C_OFF=$'\033[0m'

signed_in() {
    [ -s "${AUTH_FILE}" ] || [ -n "${OPENAI_API_KEY:-}" ]
}

status_line() {
    if [ -s "${AUTH_FILE}" ]; then
        echo "  Status: ${C_OK}signed in${C_OFF} (stored in ${AUTH_FILE}, survives restarts and updates)"
    elif [ -n "${OPENAI_API_KEY:-}" ]; then
        echo "  Status: ${C_OK}using the API key from the add-on configuration${C_OFF}"
    else
        echo "  Status: ${C_WARN}not signed in${C_OFF}"
    fi
}

finish() {
    echo
    if signed_in; then
        echo "  ${C_OK}Sign-in complete.${C_OFF} Go back to the menu and choose 1 to start Codex."
    else
        echo "  ${C_WARN}You are still not signed in.${C_OFF}"
        echo "  Run 'codex-login' again and try another method - method 1 (device code)"
        echo "  works in most cases, method 4 always works if you can run Codex on"
        echo "  another computer."
    fi
}

device_code_login() {
    echo
    echo "${C_TITLE}Device code sign-in${C_OFF}"
    echo "Codex will show a short code and a web address. Open that address on"
    echo "your phone or computer, type the code, approve, and you are done."
    echo "${C_DIM}Nothing needs to reach this container - it talks to OpenAI directly.${C_OFF}"
    echo
    if codex login --device-auth; then
        return 0
    fi
    echo
    echo "${C_WARN}The device code sign-in did not go through.${C_OFF}"
    echo "The usual reasons:"
    echo "  * Your ChatGPT workspace has device-code sign-in switched off."
    echo "    -> ask the workspace admin, or use method 2 (API key) / method 4."
    echo "  * The code expired (it is valid ~15 minutes) -> just try again."
    return 1
}

api_key_login() {
    echo
    echo "${C_TITLE}Sign in with an API key${C_OFF}"
    echo "Get a key at https://platform.openai.com/api-keys (it starts with 'sk-')."
    echo "This bills usage to your OpenAI account, separately from ChatGPT."
    echo
    printf 'Paste the key (it stays hidden) or press Enter to cancel: '
    read -rs key
    echo
    if [ -z "${key}" ]; then
        echo "Cancelled, nothing changed."
        return 1
    fi
    if codex login --api-key "${key}"; then
        echo "${C_OK}Key accepted.${C_OFF}"
        echo "Tip: paste the same key into the add-on option 'openai_api_key' so it"
        echo "is restored automatically if this container is ever rebuilt."
        return 0
    fi
    echo "${C_WARN}Codex refused that key.${C_OFF}"
    echo "Check that you copied the whole key and that it is not deleted or expired,"
    echo "then run 'codex-login' again."
    return 1
}

browser_login() {
    echo
    echo "${C_TITLE}Browser sign-in (paste the address back)${C_OFF}"
    echo "This is the ChatGPT sign-in. It needs one extra copy-paste step because"
    echo "the last redirect points at this container, not at your browser."
    echo

    local log
    log="$(mktemp)"
    codex login >"${log}" 2>&1 &
    local login_pid=$!

    local url="" i
    for i in $(seq 1 30); do
        url="$(grep -oE 'https://[^ ]*(auth|oauth|authorize)[^ ]*' "${log}" | head -n 1)"
        [ -n "${url}" ] && break
        kill -0 "${login_pid}" 2>/dev/null || break
        sleep 1
    done

    if [ -z "${url}" ]; then
        kill "${login_pid}" 2>/dev/null
        echo "${C_WARN}Codex did not print a sign-in address.${C_OFF}"
        echo "Output from Codex:"
        sed 's/^/  /' "${log}"
        rm -f "${log}"
        echo
        echo "Use method 1 (device code) instead - it needs no copy-paste."
        return 1
    fi

    cat <<EOF

  1. Open this address on your own computer or phone:

     ${url}

  2. Sign in with your ChatGPT account.
  3. At the end your browser will fail to open a page on 'localhost:${CALLBACK_PORT}'.
     That failure is expected. Copy the whole address from the browser bar.
  4. Paste it here.

EOF
    printf 'Paste the address (or type cancel): '
    read -r callback

    if [ -z "${callback}" ] || [ "${callback}" = "cancel" ]; then
        kill "${login_pid}" 2>/dev/null
        rm -f "${log}"
        echo "Cancelled, nothing changed."
        return 1
    fi

    # Point the callback at the server running inside this container.
    local local_url
    local_url="$(printf '%s' "${callback}" | sed -E "s#^https?://[^/]+#http://127.0.0.1:${CALLBACK_PORT}#")"

    if curl -sf "${local_url}" >/dev/null 2>&1; then
        wait "${login_pid}" 2>/dev/null
        rm -f "${log}"
        [ -s "${AUTH_FILE}" ] && return 0
        echo "${C_WARN}The address was accepted but no sign-in was stored.${C_OFF}"
        echo "Try method 1 (device code)."
        return 1
    fi

    kill "${login_pid}" 2>/dev/null
    rm -f "${log}"
    echo "${C_WARN}That address could not be used.${C_OFF}"
    echo "Make sure you copied the entire address including the part after '?',"
    echo "and that you did it within a few minutes. Or use method 1 (device code)."
    return 1
}

copy_auth_login() {
    echo
    echo "${C_TITLE}Bring a sign-in from another computer${C_OFF}"
    echo "If you already use Codex on your laptop, you can copy its sign-in here."
    echo
    echo "  1. On that computer find the file:  ~/.codex/auth.json"
    echo "  2. Copy it into your Home Assistant 'share' folder as:"
    echo "        codex-auth.json"
    echo "     (Settings > Add-ons > File editor, or a network share, or"
    echo "      Samba - the folder is the one called 'share')."
    echo "  3. Come back here and press Enter."
    echo
    printf 'Press Enter when the file is in place (or type cancel): '
    read -r answer
    [ "${answer}" = "cancel" ] && { echo "Cancelled, nothing changed."; return 1; }

    if [ ! -s "${SHARED_AUTH}" ]; then
        echo "${C_WARN}I cannot find ${SHARED_AUTH}.${C_OFF}"
        echo "Check the file name (it must be exactly 'codex-auth.json') and that it"
        echo "is in the 'share' folder, then run 'codex-login' again."
        return 1
    fi

    if ! jq -e . "${SHARED_AUTH}" >/dev/null 2>&1; then
        echo "${C_WARN}${SHARED_AUTH} is not a valid Codex sign-in file.${C_OFF}"
        echo "Copy it again from ~/.codex/auth.json without opening/editing it."
        return 1
    fi

    mkdir -p "${CODEX_HOME}"
    cp "${SHARED_AUTH}" "${AUTH_FILE}"
    chmod 600 "${AUTH_FILE}"
    echo "${C_OK}Sign-in copied.${C_OFF}"
    echo "You can now delete ${SHARED_AUTH} - it contains a credential."
    return 0
}

sign_out() {
    echo
    printf 'This removes the stored sign-in from this add-on. Type yes to confirm: '
    read -r answer
    if [ "${answer}" != "yes" ]; then
        echo "Nothing changed."
        return 1
    fi
    codex logout >/dev/null 2>&1
    rm -f "${AUTH_FILE}"
    echo "Signed out. Run 'codex-login' when you want to sign in again."
    return 0
}

clear
echo "${C_TITLE}  Codex sign-in${C_OFF}"
echo "${C_DIM}  ------------------------------------------------------------${C_OFF}"
status_line
cat <<EOF

  1) Device code  - recommended, works everywhere, no copy-paste of links
                    (ChatGPT Plus/Pro/Business account)
  2) API key      - paste an OpenAI API key, billed per use
  3) Browser link - ChatGPT sign-in with one manual copy-paste step
  4) Copy a sign-in from another computer
  5) Sign out
  6) Leave this screen, change nothing

EOF
printf '  Type a number and press Enter: '
read -r choice || choice=""

case "${choice}" in
    1) device_code_login ;;
    2) api_key_login ;;
    3) browser_login ;;
    4) copy_auth_login ;;
    5) sign_out; exit 0 ;;
    6|"") echo "Nothing changed."; exit 0 ;;
    *)
        echo
        echo "  ${C_WARN}'${choice}' is not one of the options.${C_OFF}"
        echo "  Run 'codex-login' again and type a number from 1 to 6."
        exit 1
        ;;
esac

finish
