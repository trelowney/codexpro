#!/bin/bash
# The screen a user lands on. It assumes the person in front of it has never
# seen this add-on before: every option says what it does, every failure says
# what to do next, and there is always a way back here.
[ -f /etc/profile.d/codexpro.sh ] && . /etc/profile.d/codexpro.sh

set -u

# Ctrl+C here (the phone key bar has a ^C key) must not end the menu: that
# ends the tmux session, and the terminal goes blank until it reconnects to
# a new one. Instead the question being asked is shown again, so nobody is
# left at an empty line. Programs started from the menu get Ctrl+C as usual
# (bash resets the trap for them).
ASKING=""
INTERRUPTED=0
trap 'INTERRUPTED=1; printf "\n%s" "${ASKING}"' INT

# The full screens need 72 columns. A phone in portrait shows about 45, where
# the lines wrap into a mess, so narrower terminals get a short form.
WIDE_COLS=72

# Width of the terminal on stdin. stty, not tput: the image has no ncurses
# tools. Not a terminal (or no answer): assume 80.
term_cols() {
    local size cols
    size=$(stty size 2>/dev/null) || size=''
    cols=${size#* }
    case "${cols}" in
        ''|*[!0-9]*|0) cols=80 ;;
    esac
    echo "${cols}"
}

is_narrow() {
    [ "$(term_cols)" -lt "${WIDE_COLS}" ]
}

# Choose the layout once per screen and remember it: drawing takes a moment
# (codex --version), and a phone turned meanwhile must not leave half a screen
# in one form and half in the other, or make ask() think the screen already
# fits.
NARROW_LAYOUT=""
pick_layout() {
    if is_narrow; then NARROW_LAYOUT=1; else NARROW_LAYOUT=0; fi
}

# ask "<prompt>" [redraw]: print the prompt and read one line into $REPLY.
# With a redraw function, the screen is drawn again when the terminal switches
# between the phone and the full layout: the menu is often drawn before anyone
# looks (at start-up tmux is 80 columns until a browser attaches), and a phone
# can be turned. Typed text waits in the terminal's line buffer until Enter,
# so a redraw does not lose it. Ctrl+C asks again and a closed input ends the
# question, as before.
ask() {
    local redraw="${2:-}" narrow now status
    ASKING="$1"
    printf '%s' "${ASKING}"
    if [ -z "${redraw}" ] || [ ! -t 0 ]; then
        read -r
        status=$?
    else
        # Compare with the layout actually drawn, not the width now
        narrow="${NARROW_LAYOUT}"
        [ -n "${narrow}" ] || { is_narrow && narrow=1 || narrow=0; }
        INTERRUPTED=0
        while :; do
            read -r -t 1
            status=$?
            [ "${status}" -eq 0 ] && break
            # Closed input: stop asking
            [ "${status}" -le 128 ] && break
            # Ctrl+C: the trap has already asked again; keep waiting, as the
            # plain read does
            if [ "${INTERRUPTED}" = 1 ]; then
                INTERRUPTED=0
                continue
            fi
            is_narrow && now=1 || now=0
            if [ "${now}" != "${narrow}" ]; then
                "${redraw}"
                narrow="${NARROW_LAYOUT:-${now}}"
                printf '%s' "${ASKING}"
            fi
        done
    fi
    ASKING=""
    return ${status}
}

WORKDIR="/homeassistant"
cd "${WORKDIR}" 2>/dev/null || cd /

C_TITLE=$'\033[1;36m'
C_DIM=$'\033[2m'
C_WARN=$'\033[1;33m'
C_OK=$'\033[1;32m'
C_OFF=$'\033[0m'

is_signed_in() {
    [ -s "${CODEX_HOME:-/data/codex}/auth.json" ] || [ -n "${OPENAI_API_KEY:-}" ]
}

# Codex puts the terminal in raw mode and turns on extended keyboard
# reporting. If it dies without undoing that (crash, out of memory, killed),
# the menu cannot see Enter and nothing echoes, so it looks frozen.
reset_terminal() {
    [ -t 0 ] || return 0
    stty sane 2>/dev/null
    # Keyboard protocols (kitty, modifyOtherKeys), bracketed paste, focus
    # events, mouse tracking, alternate screen; then show the cursor again.
    printf '\033[<u\033[>4;0m\033[?2004l\033[?1004l\033[?1000l\033[?1002l\033[?1003l\033[?1006l\033[?1049l\033[?25h'
}

pause() {
    printf '\n'
    ask "Press Enter to go back to the menu... " || true
}

codex_flags() {
    # Nothing here overrides config.toml; the add-on options already wrote it.
    printf '%s' ""
}

run_codex() {
    # $@ = extra codex arguments
    if ! command -v codex >/dev/null 2>&1; then
        echo
        echo "${C_WARN}Codex is not installed in this container.${C_OFF}"
        echo "What to do: choose '5' in the menu (Update Codex). If that fails too,"
        echo "restart the add-on in Settings > Add-ons > Codex Pro > Restart."
        pause
        return 1
    fi

    codex "$@"
    local status=$?
    reset_terminal

    if [ ${status} -ne 0 ]; then
        echo
        echo "${C_WARN}Codex stopped with an error (exit code ${status}).${C_OFF}"
        echo "What to do:"
        echo "  * If it says you are not signed in  -> choose '4' in the menu."
        echo "  * If it complains about the model -> clear the 'model' option in the"
        echo "    add-on Configuration tab (empty = whatever Codex uses by default)"
        echo "    and restart the add-on."
        echo "  * If it mentions a sandbox, bwrap or seccomp problem -> set 'file_access: full'"
        echo "    in the add-on configuration and restart the add-on."
        echo "  * Anything else -> choose '9' in the menu to run the self-check."
        pause
    fi
    return ${status}
}

header() {
    reset_terminal
    clear
    if [ "${NARROW_LAYOUT}" = 1 ]; then
        echo "${C_TITLE}  Codex Pro${C_OFF}"
        echo "${C_DIM}  ------------------------------${C_OFF}"
        if is_signed_in; then
            echo "  Account: ${C_OK}signed in${C_OFF}"
        else
            echo "  Account: ${C_WARN}not signed in - choose 4${C_OFF}"
        fi
        echo "  Codex:   $(codex --version 2>/dev/null || echo 'not available')"
        echo "  Folder:  ${WORKDIR} (= /config)"
        echo "${C_DIM}  Keeps running when you close"
        echo "  the tab. Come back any time.${C_OFF}"
        echo
        return 0
    fi
    echo "${C_TITLE}  Codex Pro for Home Assistant${C_OFF}"
    echo "${C_DIM}  ------------------------------------------------------------${C_OFF}"
    if is_signed_in; then
        echo "  Account:  ${C_OK}signed in${C_OFF}"
    else
        echo "  Account:  ${C_WARN}not signed in yet - choose 4 below${C_OFF}"
    fi
    echo "  Codex:    $(codex --version 2>/dev/null || echo 'not available')"
    echo "  Folder:   ${WORKDIR}  (same as /config in the Home Assistant docs)"
    echo "${C_DIM}  This session keeps running when you close the browser tab or"
    echo "  restart Home Assistant. Come back any time and continue.${C_OFF}"
    echo
}

show_help() {
    clear
    if is_narrow; then
        cat <<'EOF'
  What is this?
  ------------------------------
  OpenAI Codex with access to
  your Home Assistant files. Say
  what you want in plain words,
  Codex reads and edits files.

  Things you can ask it:
   "turn the porch light on at
    sunset"
   "why does my heating
    automation not trigger?"
   "a dashboard view with all
    temperature sensors"

  Where your files are:
   /config = /homeassistant
     the Home Assistant folder
   /addon_configs  other add-ons
   /share, /media  shared
   /addons         local add-ons
   /data/uploads   files from 📎
   /ssl, /backup   read-only

  After Codex changes something:
   ha-reload       apply YAML
   ha-reload --restart
                   after a
                   dashboard change

  Codex also talks to Home
  Assistant directly with:
   ha-api   REST API (entities)
   ha-ws    WebSocket (dashboards)
   mcp-update --check
  Each shows examples with --help

  The bar at the bottom shows
  🏠 ✓ when all is well. Type
  ha-status for the details.

  Leaving: close the tab any
  time, nothing is lost. Ctrl-C
  stops Codex and shows this
  menu.
EOF
        pause
        return 0
    fi
    cat <<'EOF'
  What is this?
  ------------------------------------------------------------
  A terminal running OpenAI Codex, with access to your Home
  Assistant files. You type what you want in plain language,
  Codex reads and edits the files for you.

  Things you can ask it:
    "add an automation that turns the porch light on at sunset"
    "why does my heating automation not trigger? look at the logs"
    "create a new dashboard view with all temperature sensors"

  Where your files are:
    /config  and  /homeassistant   -> the same Home Assistant folder
    /addon_configs                 -> configuration of other add-ons
    /share, /media                 -> shared folders
    /addons                        -> local add-ons (your own add-ons)
    /data/uploads                  -> files you uploaded with 📎
    /ssl, /backup                  -> read-only

  After Codex changes something:
    run  ha-reload           to apply YAML changes
    run  ha-reload --restart if you changed a dashboard

  Codex can also talk to Home Assistant directly, not just to the
  files. Three commands do that, and Codex knows about them:
    ha-api GET /api/states          the REST API (entities, services)
    ha-ws  lovelace/dashboards/list the WebSocket API (dashboards)
    mcp-update --check              is the connection up to date?
  Each of them prints examples with  --help.

  The bar at the bottom shows your home: 🏠 ✓ when all is well,
  otherwise what needs a look. Type  ha-status  for the details
  and what to do. The add-on option 'status_line' changes it.

  Leaving:
    Close the browser tab whenever you like - nothing is lost.
    Press Ctrl-C to stop Codex and return to this menu.
EOF
    pause
}

welcome_screen() {
    pick_layout
    clear
    if [ "${NARROW_LAYOUT}" = 1 ]; then
        cat <<EOF
  ${C_TITLE}Welcome to Codex Pro${C_OFF}

  Sign in once before Codex can
  do anything. It takes a minute
  and is kept across restarts
  and updates of this add-on.

  Press Enter to sign in, or
  type 'skip' to see the menu.
EOF
    else
        cat <<EOF
  ${C_TITLE}Welcome to Codex Pro${C_OFF}

  You need to sign in once before Codex can do anything. It takes a
  minute and you only do it once - the sign-in is stored and survives
  restarts and updates of this add-on.

  Press Enter to start the sign-in, or type 'skip' to see the menu first.
EOF
    fi
    printf '\n'
}

first_run_hint() {
    is_signed_in && return 0
    welcome_screen
    # A closed input: show the menu rather than start the sign-in
    local answer
    ask "  > " welcome_screen && answer="${REPLY}" || answer="skip"
    case "${answer}" in
        skip|s|S) return 0 ;;
        *) codex-login ;;
    esac
}

# Auto-launch straight into Codex on the very first attach, but only when the
# user is actually signed in - otherwise they would land in an error screen.
if [ "${CODEXPRO_AUTO_LAUNCH:-true}" = "true" ] && is_signed_in; then
    clear
    echo "${C_TITLE}Starting Codex...${C_OFF}"
    echo "${C_DIM}Press Ctrl-C to stop it and get the menu.${C_OFF}"
    sleep 1
    run_codex
else
    first_run_hint
fi

main_menu() {
    pick_layout
    header
    if [ "${NARROW_LAYOUT}" = 1 ]; then
        cat <<EOF
  1) New Codex session
  2) Continue my last session
  3) Pick an earlier session
  4) Sign in / switch account
  5) Update Codex
  6) Apply my HA changes
  7) Plain shell
  8) What can I do here?
  9) Self-check (if odd)
EOF
    else
        cat <<EOF
    1) Start a new Codex session
    2) Continue where I left off (last session)
    3) Pick one of my earlier sessions
    4) Sign in / switch account
    5) Update Codex to the newest version
    6) Apply my Home Assistant changes (check + reload)
    7) Plain shell (for people who know their way around)
    8) What can I do here?
    9) Self-check (run this if something behaves oddly)
EOF
    fi
    printf '\n'
}

while true; do
    main_menu
    ask "  Type a number and press Enter: " main_menu && choice="${REPLY}" || choice=""

    case "${choice}" in
        1) clear; run_codex ;;
        2)
            clear
            if codex resume --help >/dev/null 2>&1; then
                run_codex resume --last
            else
                echo "${C_WARN}This version of Codex cannot resume sessions.${C_OFF}"
                echo "What to do: choose '5' to update Codex, then try again."
                pause
            fi
            ;;
        3)
            clear
            if codex resume --help >/dev/null 2>&1; then
                echo "Pick a session from the list; press Esc to come back."
                sleep 1
                run_codex resume
            else
                echo "${C_WARN}This version of Codex cannot resume sessions.${C_OFF}"
                echo "What to do: choose '5' to update Codex, then try again."
                pause
            fi
            ;;
        4) clear; codex-login; pause ;;
        5) clear; codex-update; pause ;;
        6) clear; ha-reload; pause ;;
        7)
            clear
            echo "You are in a normal shell. Type 'exit' to come back to this menu."
            echo
            bash -l
            ;;
        8) show_help ;;
        9) clear; codex-doctor; pause ;;
        "")
            ;;
        *)
            echo
            echo "  ${C_WARN}'${choice}' is not one of the options.${C_OFF}"
            echo "  Type one of the numbers above"
            echo "  (for example 1) and press Enter."
            sleep 2
            ;;
    esac
done
