{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          { "type": "command", "command": "/usr/local/bin/python3 /opt/codexpro-ha/hooks/codex_yaml_check.py", "timeout": 5 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(apply_patch|Bash)$",
        "hooks": [
          { "type": "command", "command": "/usr/local/bin/python3 /opt/codexpro-ha/hooks/codex_yaml_check.py", "timeout": 30 }
        ]
      }
    ]
  }
}
